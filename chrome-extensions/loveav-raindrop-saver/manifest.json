{
  "manifest_version": 3,
  "name": "LoveAV 一体化工具",
  "version": "0.10.3",
  "minimum_chrome_version": "116",
  "side_panel": { "default_path": "layout-panel.html" },
  "description": "集成番号过滤、MissAV / 123AV 收藏及 51cg 文章标题与标签保存到 Raindrop。",
  "action": {
    "default_title": "打开 LoveAV 一体化工作台"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.raindrop.io/*",
    "https://raindrop.io/*",
    "https://missav.ai/*",
    "https://*.missav.ai/*",
    "https://missav.ws/*",
    "https://*.missav.ws/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://missav.ai/*",
        "https://*.missav.ai/*",
        "https://missav.ws/*",
        "https://*.missav.ws/*",
        "https://123av.com/*",
        "https://*.123av.com/*"
      ],
      "js": [
        "filter-core.js",
        "loveav-core.js",
        "page-metadata.js",
        "missav-resolver.js",
        "page-selection.js",
        "home-loader.js",
        "layout-controller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://51cg1.com/*", "https://www.51cg1.com/*"],
      "js": ["popup-guard-main.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://51cg1.com/*", "https://www.51cg1.com/*"],
      "js": ["popup-guard-sync.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://51cg1.com/*", "https://www.51cg1.com/*"],
      "js": ["reading-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://51cg1.com/archives/*", "https://www.51cg1.com/archives/*"],
      "js": ["cg-article.js", "cg-content.js"],
      "run_at": "document_idle"
    }
  ]
}
