{
  "manifest_version": 3,
  "name": "LoveAV 一体化工具",
  "version": "0.6.0",
  "description": "集成番号过滤、手动番号解析及 MissAV / 123AV 一键收藏到 Raindrop。",
  "action": {
    "default_title": "打开 LoveAV 一体化工作台"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.raindrop.io/*",
    "https://raindrop.io/*",
    "https://missav.ai/*",
    "https://*.missav.ai/*",
    "https://missav.ws/*",
    "https://*.missav.ws/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://missav.ai/*",
        "https://*.missav.ai/*",
        "https://missav.ws/*",
        "https://*.missav.ws/*",
        "https://123av.com/*",
        "https://*.123av.com/*"
      ],
      "js": [
        "filter-core.js",
        "loveav-core.js",
        "page-selection.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
